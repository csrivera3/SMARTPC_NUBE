# MesaPass API - Environment Configuration Template
# Copy this to .env and fill in values for your environment

# ==================== SERVIDOR ====================
# development | production
ENVIRONMENT=development

# true | false
DEBUG=false

# debug | info | warning | error | critical
LOG_LEVEL=info

# Skip database initialization on app startup (useful for managed databases)
# true | false
SKIP_DB_ON_STARTUP=false

# ==================== BASE DE DATOS ====================
# REQUERIDA: Connection string PostgreSQL
# Ejemplos:
#   Local: postgresql://postgres:password@localhost:5432/mesa_db
#   Railway: postgresql://postgres:AbCdEf@containers-us-west-XXX.railway.app:5432/railway
#   Render: postgresql://user:pass@render-db.onrender.com:5432/db_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/mesa_db

# ==================== AUTENTICACIÓN ====================
# REQUERIDA: Cambiar en producción a valor seguro
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-12345

# ==================== CORS ====================
# REQUERIDA en producción: Dominios frontend permitidos (separados por comas)
# Ejemplos:
#   Local: http://localhost:3000,http://localhost:3001
#   Production: https://app.example.com,https://dashboard.example.com
#   En desarrollo vacío usa defaults de localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ==================== SERVIDOR (Uvicorn) ====================
# Host para bind (0.0.0.0 para Docker/Railway, 127.0.0.1 para local)
HOST=127.0.0.1

# Puerto
PORT=8000

# Habilitar reload automático (solo desarrollo)
RELOAD=true

# Número de workers (1 para desarrollo, >1 para producción)
WORKERS=1

