# ============================================================================
# Railway Environment Configuration - Production
# ============================================================================
# These variables are automatically injected by Railway
# DO NOT commit real DATABASE_URL or SECRET_KEY to version control

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Railway automatically injects PORT - do NOT set it here
# HOST should remain 0.0.0.0 to accept connections from Railway proxy
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# DATABASE CONFIGURATION (CRITICAL - Must be configured in Railway)
# ============================================================================
# Railway will automatically inject DATABASE_URL when you:
# 1. Create a PostgreSQL plugin in Railway
# 2. Connect it to this service
# 
# Format: postgresql://username:password@host:port/database
# DO NOT hardcode this - use Railway's automatic variable injection
# If DATABASE_URL is not set, app will start but database operations will fail
# 
# Example (for reference only - DO NOT COPY):
# DATABASE_URL=postgresql://postgres:password@containers-us-west-78.railway.app:5432/railway

DATABASE_URL=${DATABASE_URL}

# ============================================================================
# SECURITY
# ============================================================================
# IMPORTANT: Set a strong SECRET_KEY in Railway Dashboard
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit this to version control
SECRET_KEY=${SECRET_KEY}

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
# Will be read by app.core.config and expanded to CORS middleware
ALLOWED_ORIGINS=https://${RAILWAY_DOMAIN},https://www.${RAILWAY_DOMAIN}

# ============================================================================
# APPLICATION METADATA (Optional)
# ============================================================================
# Used for informational purposes in /info endpoint
APP_VERSION=1.0.0
APP_NAME=MesaPass API
